# Server (see server/src/index.ts)
CUBEWARS_SERVER_PORT=7777

# Economy SQLite path (EPIC 23). Default: <server package>/data/economy.sqlite
# Use an absolute path in production. Single server process only — do not share
# this file across multiple Node processes.
# CUBEWARS_ECONOMY_DB=server/data/economy.sqlite

# Egg incubation duration override in milliseconds (EPIC 24). Positive integer
# only; applied when an egg is granted (kill drop / store grant). Default is
# 24h (INCUBATION.durationMs in shared). Use a short value for QA/tests —
# do not leave a short override set in production.
# CUBEWARS_INCUBATION_MS=86400000
