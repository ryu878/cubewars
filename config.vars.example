# Server (see server/src/index.ts)
CUBEWARS_SERVER_PORT=7777

# Redis (economy + avatar + account sessions). Same instance / URL; separate key namespaces.
# Economy: cw:economy:v1:…  Avatar: cw:avatar:v1:…  Accounts: cw:account:v1:…
# CUBEWARS_REDIS_URL=redis://127.0.0.1:6379

# Legacy SQLite path — IMPORT ONLY (EPIC 27). Not used at runtime after Redis.
# Default: <server package>/data/economy.sqlite
# CUBEWARS_ECONOMY_DB=server/data/economy.sqlite

# One-shot SQLite → Redis import (EPIC 27).
# Auto-import (marker missing + SQLite file present): imports ONLY nicknames that
# do not already have a Redis economy key — never clobbers live Redis progress.
# Marker cw:meta:sqlite_imported is also set when the SQLite file is missing, so a
# later file cannot surprise-import.
# CUBEWARS_SQLITE_IMPORT=1 FORCE-overwrites existing Redis keys for nicknames in
# SQLite — DESTROYS overlapping live Redis progress. Use only for deliberate
# re-import; server logs a loud warning. Default is 0 (no clobber).
# CUBEWARS_SQLITE_IMPORT=0

# Egg incubation duration override in milliseconds (EPIC 24). Positive integer
# only; applied when an egg is granted (kill drop / store grant). Default is
# 24h (INCUBATION.durationMs in shared). Use a short value for QA/tests —
# do not leave a short override set in production.
# CUBEWARS_INCUBATION_MS=86400000
