{
  "name": "cubewars",
  "private": true,
  "version": "0.0.1",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "build": "npm run build --workspace=server && npm run build --workspace=client",
    "typecheck": "npm run typecheck --workspace=shared && npm run typecheck --workspace=server && npm run typecheck --workspace=client",
    "regression:collision-overshoot": "tsx scripts/regression-collision-overshoot.ts",
    "regression:bot-aim-miss-rate": "tsx scripts/regression-bot-aim-miss-rate.ts",
    "regression:crate-mount": "tsx scripts/regression-crate-mount.ts",
    "regression:weapon-autoswitch": "tsx scripts/regression-weapon-autoswitch.ts",
    "regression:playerstate-equipped-weapon": "tsx scripts/regression-playerstate-equipped-weapon.ts",
    "regression:locational-splash-damage": "tsx scripts/regression-locational-splash-damage.ts",
    "regression:grenade-projectile": "tsx scripts/regression-grenade-projectile.ts",
    "regression:lobby-nicknames": "tsx scripts/regression-lobby-nicknames.ts",
    "regression:leaderboard": "tsx scripts/regression-leaderboard.ts",
    "regression:endless": "tsx scripts/regression-endless-mode.ts",
    "regression:economy-gold": "tsx scripts/regression-economy-gold.ts",
    "regression:economy-pets": "tsx scripts/regression-economy-pets.ts",
    "regression:fire-input-drop-rate": "node scripts/regression-fire-input-drop-rate.mjs",
    "qa:epic17-avatar-selfcheck": "node scripts/qa-epic17-avatar-selfcheck.mjs",
    "qa:epic18-hold-fire": "node scripts/qa-epic18-hold-fire.mjs",
    "qa:epic19-combat-effects": "node scripts/qa-epic19-combat-effects.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "playwright": "1.62.1",
    "typescript": "^5.6.3"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true
  }
}
